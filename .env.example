# Copy to .env and set ONE key. The first present picks the provider, in this
# order: OpenAI -> Google -> Anthropic. The rest of the site (browse, book,
# "my bookings") runs without any key; only the chat agent needs one.
#
# NOTE: a free-tier Google AI Studio key is capped at ~5 requests/minute, and
# one chat turn can spend 2-4 (the agent calls the model, runs a tool, calls
# again). If chat returns "429 / quota exceeded", use an OpenAI or Anthropic
# key instead, or enable billing on the Google project.

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the default model for the chosen provider.
# LLM_MODEL=
